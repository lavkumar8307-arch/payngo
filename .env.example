# PayNGo Environment Configuration
# PayPal Developer Sandbox Credentials (https://developer.paypal.com)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_secret_here
PAYPAL_ENV=sandbox # 'sandbox' or 'live'

# Google Gemini 1.5 Flash (100% Free Tier: https://aistudio.google.com)
GEMINI_API_KEY=your_free_google_gemini_api_key_here

# Anthropic Claude API Key (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Maps API Key (Optional, Leaflet radar fallback included)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Supabase Database & Auth (https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
