# ===========================
# WanderPay - .gitignore
# ===========================

# ---- Environment & Secrets (NEVER commit these) ----
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# ---- Next.js ----
/.next/
/out/
/build/

# ---- Node Modules ----
/node_modules/

# ---- Package Manager Locks ----
yarn.lock
pnpm-lock.yaml
.pnp
.pnp.js

# ---- OS Files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Editor & IDE ----
.vscode/settings.json
.idea/
*.swp
*.swo

# ---- Debug & Logs ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- TypeScript Build Cache ----
*.tsbuildinfo
next-env.d.ts

# ---- Vercel ----
.vercel

# ---- Testing ----
/coverage/
.vercel
.env*
!.env.example
